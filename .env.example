# Django
SECRET_KEY=change-me
DEBUG=false
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RAILWAY_PUBLIC_DOMAIN=
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SITE_ID=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database
DB_ENGINE=mysql
DB_NAME=feed_on
DB_USER=feed_on
DB_PASSWORD=feed_on_password
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_URL=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=
MYSQLHOST=
MYSQLPORT=

# Celery
REDIS_URL=redis://127.0.0.1:6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# Ontology
FEED_ON_ONTOLOGY_PATH=ontology/FEED-ON.owl
FEED_ON_RUN_REASONER=true
FEED_ON_REASONER=pellet

# OpenAI
OPENAI_API_KEY='sua_chave_aqui'
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_BATCH_SIZE=50
OPENAI_ENABLE_ANALYSIS=true

# Jira
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-api-token
JIRA_PROJECT_KEY=FEED
JIRA_ISSUE_TYPE=Task
JIRA_BUG_ISSUE_TYPE=Bug
JIRA_IMPROVEMENT_ISSUE_TYPE=Task
JIRA_DRY_RUN=true

# Processing
FEEDBACK_CHUNK_SIZE=50
MAX_UPLOAD_SIZE_MB=200





