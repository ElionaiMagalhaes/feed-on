<owl:NamedIndividual rdf:about="FEED-ON:Feedback_e61cea9f_94e2_4404_ad9c_98d469c68f6e__job13__row765">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_e61cea9f_94e2_4404_ad9c_98d469c68f6e__job13__row765"/>
