  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Subscription"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_6bbfced3_3801_42b9_934f_acde66fc2791__job13__row402"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_6bbfced3_3801_42b9_934f_acde66fc2791__job13__row402"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_6bbfced3_3801_42b9_934f_acde66fc2791__job13__row402"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 6bbfced3-3801-42b9-934f-acde66fc2791__job13__row402</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">One episode of my usual Kdrama used to have only 2 ads which was acceptable since I pay less subscription, now my 1 hour episode has ads every 10 minutes. I am watching a Kdrama series now with English dub but its not even synchronised with the original and often I get confused who's talking. Not to mention it takes a month to get new movies or series.What a complete rip off. Seriously, you made so much money in 2025, at least a good service is not too much to ask.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

