  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_aecf0b4b_950d_4940_8540_51f7e873818a__job13__row452"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback aecf0b4b-950d-4940-8540-51f7e873818a__job13__row452</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">My experience with Netflix has been mostly positive. The content selection is diverse and regularly updated. However, I hope Netflix can improve its recommendation system to better match my preferences and consider offering more affordable subscription options.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

