  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_e61cea9f_94e2_4404_ad9c_98d469c68f6e__job13__row765"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_e61cea9f_94e2_4404_ad9c_98d469c68f6e__job13__row765"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback e61cea9f-94e2-4404-ad9c-98d469c68f6e__job13__row765</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I like Netflix, however, it takes too long to replace and add new movies. Netflix should be better than Tubi. No commercials please. It should be movies , documentaries, comedy, and games only. Add some old movies. Ask customers what they would like to see.</seon:commentText>
