<owl:NamedIndividual rdf:about="FEED-ON:Feedback_14b84b37_fdb5_470a_9295_b80dd2dd2350__job13__row610">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/QualityAttribute_Quality"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_14b84b37_fdb5_470a_9295_b80dd2dd2350__job13__row610"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_14b84b37_fdb5_470a_9295_b80dd2dd2350__job13__row610"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_14b84b37_fdb5_470a_9295_b80dd2dd2350__job13__row610"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 14b84b37-fdb5-470a-9295-b80dd2dd2350__job13__row610</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">⭐⭐⭐⭐⭐ Absolutely the Best Streaming Platform! Netflix is hands down the best entertainment app ever! The variety of movies, web series, anime, thrillers, and documentaries is just amazing. From intense action to emotional dramas, there’s something for every mood. The video quality is top-class, streaming is super smooth, and new content keeps coming regularly. I especially love the original series — they are on another level! Perfect for binge-watching with friends or family. Totally worth it.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

