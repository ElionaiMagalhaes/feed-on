  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/UIElement_Screen"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_1842d38d_cb19_4d0c_ad50_257b4189df7f__job13__row290"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_1842d38d_cb19_4d0c_ad50_257b4189df7f__job13__row290"/>
