  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Premium"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_02f60b89_e791_463d_9301_bf70b0ab5cea__job13__row634"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_02f60b89_e791_463d_9301_bf70b0ab5cea__job13__row634"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_02f60b89_e791_463d_9301_bf70b0ab5cea__job13__row634"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 02f60b89-e791-463d-9301-bf70b0ab5cea__job13__row634</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Experience seems to get worse over time... -Games constantly being pushed when I have no interest in playing games on a video streaming service. -My 'currently watching' list keeps vanishing, and when it doesn't I would prefer if it was always at the top and I didn't have to go searching for it -App claims I am using a VPN when I'm not, and the help page implies that VPNs are allowed for premium paying members, which I am, so why is it complaining to begin with?</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

