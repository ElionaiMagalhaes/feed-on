  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_ef60a83d_aa0b_446c_83e1_a490d1f537c1__job13__row91"/>
