  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_7c350854_b7b3_4600_bdaa_76126191a1e7__job13__row811"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_7c350854_b7b3_4600_bdaa_76126191a1e7__job13__row811"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 7c350854-b7b3-4600-bdaa-76126191a1e7__job13__row811</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Netflix is starting to feel like the grandfather of streaming services. fragmented recollection(shows with only half the seasons available), obnoxiously rigid in belief(can't minimize the screen to use my phone like every other service), and a strange feeling of superiority for having the good fortune of being born in a time that allowed easy acquisition of equity(high cost for less returns then the competitors). But, it would be disrespectful not to go visit grandpa every so often.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

