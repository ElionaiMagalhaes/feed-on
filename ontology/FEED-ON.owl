  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_6ed49646_e3a5_4fc5_a49e_5c5aa6e15a7b__job13__row318"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_6ed49646_e3a5_4fc5_a49e_5c5aa6e15a7b__job13__row318"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_6ed49646_e3a5_4fc5_a49e_5c5aa6e15a7b__job13__row318"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 6ed49646-e3a5-4fc5-a49e-5c5aa6e15a7b__job13__row318</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">They want unnecessary info, says I can't sign in unless it has my location and SMS in permission to google play services just to send me a email confirmation with the wrong sign in location. turned both settings off asap after signing in and nothing changed or stopped. data scrapping at every step of the way. you should also use DNS net to see traffic logs and protect yourself. has gone down since they stopped mailing DVDs. if I wanted spyware I'd torrent download a vires filled bootleg. Shame</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

