<owl:NamedIndividual rdf:about="FEED-ON:Feedback_e37b8683_0134_45fe_8fc7_131f846336cc__job13__row586">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_e37b8683_0134_45fe_8fc7_131f846336cc__job13__row586"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_e37b8683_0134_45fe_8fc7_131f846336cc__job13__row586"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_e37b8683_0134_45fe_8fc7_131f846336cc__job13__row586"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback e37b8683-0134-45fe-8fc7-131f846336cc__job13__row586</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It’s terrible when, for example, you want to search for something. The filtering system is very poor — whether you’re looking for film titles or audio tracks. In the age of AI, it’s a huge disadvantage that Netflix doesn’t use these kinds of advanced features, which could greatly enhance the viewer experience.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

