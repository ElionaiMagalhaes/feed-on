<owl:NamedIndividual rdf:about="FEED-ON:Feedback_7c350854_b7b3_4600_bdaa_76126191a1e7__job13__row811">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/UIElement_Screen"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_7c350854_b7b3_4600_bdaa_76126191a1e7__job13__row811"/>
