<owl:NamedIndividual rdf:about="FEED-ON:Feedback_ae42d0c2_5aa2_4b44_8759_34a6f31ae78b__job13__row453">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_ae42d0c2_5aa2_4b44_8759_34a6f31ae78b__job13__row453"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_ae42d0c2_5aa2_4b44_8759_34a6f31ae78b__job13__row453"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_ae42d0c2_5aa2_4b44_8759_34a6f31ae78b__job13__row453"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback ae42d0c2-5aa2-4b44-8759-34a6f31ae78b__job13__row453</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">This app has gone downhill and almost impossible to connect to from our TV. We have so many issues connecting that we end up streaming HULU, Prime and everything other than Netflix. fix your glitchiness or you'll continue to fall in the ranks when we can't even watch or open the app. I don't have these issues with our other streaming services so it must be on your end. No longer #1.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

