<owl:NamedIndividual rdf:about="FEED-ON:Feedback_e7f03518_6578_4585_8256_2a671b379edd__job13__row678">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/QualityAttribute_Slow"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_e7f03518_6578_4585_8256_2a671b379edd__job13__row678"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_e7f03518_6578_4585_8256_2a671b379edd__job13__row678"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_e7f03518_6578_4585_8256_2a671b379edd__job13__row678"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback e7f03518-6578-4585-8256-2a671b379edd__job13__row678</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Netflix's slow enblankification is sad. Had it from the DVD days to 2023. Too costly now. A lot like the cable TV we hated cuz we only wanted a few channels but had to pay for packages with all. I don't care about sports or gaming but it's included, no plan without them. Removal of cast support is another straw. 13 wks outside US last year + often cast to TVs in hotels. Don't want 2 set up TV then remove after. Prefer using my phone as a remote v an ugly TV app or new chromecast w/ remote.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Correction_e7f03518_6578_4585_8256_2a671b379edd__job13__row678">
