<owl:NamedIndividual rdf:about="FEED-ON:Feedback_dfdccf3e_a787_4f5c_97a8_96f375566f23__job13__row448">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_dfdccf3e_a787_4f5c_97a8_96f375566f23__job13__row448"/>
