  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback f419cd17-d887-473b-a1f5-e71765704cd6__job13__row566</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I had Netflix 4 a long time Nvr had a prob I don't care if the price was lowered 4 ads! I DON'T WANT THE FREAKING ADS! would rather pay what I was 4 no ads but wasnt even given a choice. Not once in years did I have a prblm with skipping freezing distorting but now I cant get through a movie without it. not to mention the dumb movie selection to choose from. I wish it was back to how it started where you could choose ANY movie and you'd receive a dvd in the mail or at least as it was 2 years ago</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Correction_f419cd17_d887_473b_a1f5_e71765704cd6__job13__row566">
