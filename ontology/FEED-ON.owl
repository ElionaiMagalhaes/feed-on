<owl:NamedIndividual rdf:about="FEED-ON:Feedback_3e25488b_a325_43cc_85d2_8b880443dafe__job13__row605">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Household"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_3e25488b_a325_43cc_85d2_8b880443dafe__job13__row605"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_3e25488b_a325_43cc_85d2_8b880443dafe__job13__row605"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_3e25488b_a325_43cc_85d2_8b880443dafe__job13__row605"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 3e25488b-a325-43cc-85d2-8b880443dafe__job13__row605</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0 stars, the whole household thing just made Netflix fall into the deepest pit of streaming services. Never had I had a worse experience trying to sign in and watch a show or movie I wanted to see only to be told my own account is not in the "right household" and this happens every single time I log in. If I could rate this app and the ones who decided the household rule (which shouldn't even be looking at my location without my permission, might I add) with negative stars, I would.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

