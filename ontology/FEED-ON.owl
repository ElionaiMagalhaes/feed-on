<owl:NamedIndividual rdf:about="FEED-ON:Feedback_6455986e_596a_4f78_8ef1_5e25384ab72b__job13__row454">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/QualityAttribute_Quality"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_6455986e_596a_4f78_8ef1_5e25384ab72b__job13__row454"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_6455986e_596a_4f78_8ef1_5e25384ab72b__job13__row454"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_6455986e_596a_4f78_8ef1_5e25384ab72b__job13__row454"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 6455986e-596a-4f78-8ef1-5e25384ab72b__job13__row454</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I have been a subscriber for nearly 2 years, and pay for premium (no-ads plus the ability to watch on 4 devices) plus an extra member. It constantly signs me out of the same 2 devices and I only have it on 3.... what am I spending $34.30 a month for the? SO annoying. The quality of shows has went down drastically in the past year in my opinion.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

