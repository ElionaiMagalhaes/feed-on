  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_456fdc2d_e53d_42a7_8b0d_902e2c39e8b9__job13__row481"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_456fdc2d_e53d_42a7_8b0d_902e2c39e8b9__job13__row481"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 456fdc2d-e53d-42a7-8b0d-902e2c39e8b9__job13__row481</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I had a very disappointing experience with Netflix. I made a payment through UPI AutoPay, and the money was deducted from my bank account immediately. However, my subscription was never activated. Even after cancelling AutoPay, there was no clear communication about the refund process. It is extremely frustrating that the amount was taken but the service was not provided. On top of that, the help center support was very poor and unhelpful. It was difficult to get clear answers, and the issue was</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

