<owl:NamedIndividual rdf:about="FEED-ON:Feedback_d690e1a3_63b1_47c8_a75b_3de0db3bd5b9__job13__row265">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/UIElement_Interface"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_d690e1a3_63b1_47c8_a75b_3de0db3bd5b9__job13__row265"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_d690e1a3_63b1_47c8_a75b_3de0db3bd5b9__job13__row265"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_d690e1a3_63b1_47c8_a75b_3de0db3bd5b9__job13__row265"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback d690e1a3-63b1-47c8-a75b-3de0db3bd5b9__job13__row265</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Excellent Streaming Platform! I’ve been using Netflix for years, and it continues to be one of the best entertainment platforms available. The app is easy to use, with a clean interface and smooth streaming quality. I really appreciate how it recommends shows and movies based on my watching history — it makes finding something new to watch much easier. The variety of content is impressive, from international movies and series to documentaries and Netflix Originals.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

