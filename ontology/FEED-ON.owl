<owl:ObjectProperty rdf:about="http://dev.nemo.inf.ufes.br/seon/refersTo">
  <rdfs:domain rdf:resource="FEED-ON::Feedback"/>
  <rdfs:range rdf:resource="FEED-ON::Target"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first rdf:resource="http://dev.nemo.inf.ufes.br/seon/refersTo"/>
      <rdf:rest>
        <rdf:Description>
