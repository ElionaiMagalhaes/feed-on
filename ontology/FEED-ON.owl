  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Subscription"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_456fdc2d_e53d_42a7_8b0d_902e2c39e8b9__job13__row481"/>
