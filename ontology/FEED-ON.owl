<owl:NamedIndividual rdf:about="FEED-ON:Feedback_981b2969_c267_4356_b13a_5006f22f2b0b__job13__row681">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Pay"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_981b2969_c267_4356_b13a_5006f22f2b0b__job13__row681"/>
