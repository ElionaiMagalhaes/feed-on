<owl:NamedIndividual rdf:about="FEED-ON:Feedback_081ea334_a6ee_4026_9599_de8231612f75__job13__row671">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Pay"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_081ea334_a6ee_4026_9599_de8231612f75__job13__row671"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_081ea334_a6ee_4026_9599_de8231612f75__job13__row671"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_081ea334_a6ee_4026_9599_de8231612f75__job13__row671"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 081ea334-a6ee-4026-9599-de8231612f75__job13__row671</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Too much trouble now when you travel. It used to give me an option to say, "I'm traveling." It no longer does that. I travel for work, and now my kids or spouse can't watch Netflix at the same time as me if I am traveling. We used to for years. Netflix said we can only stream one TV at a time no matter if we pay for 2 or 4 devices to stream at the same time. If we pay to stream for 2 or 4 devices, we should be able to watch it in 2 or 4 TVs.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Correction_081ea334_a6ee_4026_9599_de8231612f75__job13__row671">
