  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_981b2969_c267_4356_b13a_5006f22f2b0b__job13__row681"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_981b2969_c267_4356_b13a_5006f22f2b0b__job13__row681"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 981b2969-c267-4356-b13a-5006f22f2b0b__job13__row681</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Its like mobile game ads but with film. Its unskippable, multiple ads. The ads are very annoying, you cannot escape them if you dont pay into netflixs GREED. They used to be good for the economy back in early 2000's but now its abt $20 a MONTH and more for no ads. Mind you, its glitchy(for me), lies about being able to screencast, and removes beutiful works of film for the latest movie with Jacob Elordi. A show will automaticlly pause and i cant unpause. It has some great films, though.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

