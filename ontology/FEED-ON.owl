<owl:NamedIndividual rdf:about="FEED-ON:Feedback_caf6d404_a91b_4ba9_90b6_93cf5f641cc7__job13__row763">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_caf6d404_a91b_4ba9_90b6_93cf5f641cc7__job13__row763"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_caf6d404_a91b_4ba9_90b6_93cf5f641cc7__job13__row763"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_caf6d404_a91b_4ba9_90b6_93cf5f641cc7__job13__row763"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback caf6d404-a91b-4ba9-90b6-93cf5f641cc7__job13__row763</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I’d love to have playback speed controls (1.25x, 1.5x, 1.75x, 2x) available on the Netflix TV app and on laptop browsers. This feature already exists on mobile, and having the same option across all devices would make watching long episodes, documentaries, and rewatching content much more efficient. It would really improve the viewing experience. I know a lot of people who watches shows 1.5x like me. 😁</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Improvement_caf6d404_a91b_4ba9_90b6_93cf5f641cc7__job13__row763">
