<owl:NamedIndividual rdf:about="FEED-ON:Feedback_dc04778a_b5e1_40b8_8b2d_f8bbf4f074fa__job13__row451">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_dc04778a_b5e1_40b8_8b2d_f8bbf4f074fa__job13__row451"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_dc04778a_b5e1_40b8_8b2d_f8bbf4f074fa__job13__row451"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_dc04778a_b5e1_40b8_8b2d_f8bbf4f074fa__job13__row451"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback dc04778a-b5e1-40b8-8b2d-f8bbf4f074fa__job13__row451</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I've been a Netflix subscriber for several years, and I can confidently say it’s one of the best entertainment platforms out there! The variety of content is simply unmatched, from original series like "Stranger Things" and "The Crown" to an extensive library of movies from various genres.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Improvement_dc04778a_b5e1_40b8_8b2d_f8bbf4f074fa__job13__row451">
