<owl:NamedIndividual rdf:about="FEED-ON:Feedback_7e5e3d4d_1f39_4de5_a5d1_0b1bcd69f7c5__job13__row495">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_7e5e3d4d_1f39_4de5_a5d1_0b1bcd69f7c5__job13__row495"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_7e5e3d4d_1f39_4de5_a5d1_0b1bcd69f7c5__job13__row495"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_7e5e3d4d_1f39_4de5_a5d1_0b1bcd69f7c5__job13__row495"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 7e5e3d4d-1f39-4de5-a5d1-0b1bcd69f7c5__job13__row495</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">We're extremely disappointed about Netflix inexplicably choosing to remove casting support. Casting from our phones has been how we like to control our set top devices, since the first Chromecast was released. This makes the app essentially useless for us, since we almost never watch on mobile devices. We've dropped to the cheapest plan, and are considering whether even that's worth keeping, now.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

