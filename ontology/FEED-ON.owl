  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_dfdccf3e_a787_4f5c_97a8_96f375566f23__job13__row448"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_dfdccf3e_a787_4f5c_97a8_96f375566f23__job13__row448"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback dfdccf3e-a787-4f5c-97a8-96f375566f23__job13__row448</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I rate Netflix 5 stars because I can watch my favorite shows and movies. This app entertains me and hopefully other people too theres stuff other apps cant have that Netflix does also I can have Netflix on a tablet, phone, laptop and more. This isn't just for watching this is also experience there's romance, comedies, and I'm pretty sure lots more. Netflix gives emotions with friends or family and connects us with our favorite shows and movies. and thats why I rate Netflix five stars.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

