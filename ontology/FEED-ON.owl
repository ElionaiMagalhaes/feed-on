<owl:NamedIndividual rdf:about="FEED-ON:Feedback_a4bf86d4_2955_4431_aa13_c526d246d246__job13__row376">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_a4bf86d4_2955_4431_aa13_c526d246d246__job13__row376"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_a4bf86d4_2955_4431_aa13_c526d246d246__job13__row376"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_a4bf86d4_2955_4431_aa13_c526d246d246__job13__row376"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback a4bf86d4-2955-4431-aa13-c526d246d246__job13__row376</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Netflix is the best app to watch movies it is the best ott platform I have never seen Still the Best Social App! Netflix continues to be a great platform for staying in touch with friends, discovering events, joining groups, and sharing memories. I love how easy it is to post updates, browse photos, and interact with content. The Marketplace is super useful, and the ability to follow pages and interests keeps my feed engaging. It's a one-stop place for social connection. Highly recommended!</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

