  <rdfs:comment xml:lang="en">Operational version of the FEED-ON reference ontology developed using SABiOx.</rdfs:comment>
  <rdfs:label xml:lang="en">FEED-ON: Feedback Ontology</rdfs:label>
  <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.1</owl:versionInfo>
</owl:Ontology>

<owl:ObjectProperty rdf:about="http://dev.nemo.inf.ufes.br/seon/aimsToEvolve">
  <rdfs:domain rdf:resource="FEED-ON::ConsequenceExpected"/>
  <rdfs:range rdf:resource="FEED-ON::Target"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">It defines which software component the developer should open to perform the correction or improvement.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://dev.nemo.inf.ufes.br/seon/derivedFrom">
  <owl:inverseOf rdf:resource="http://dev.nemo.inf.ufes.br/seon/indicates"/>
  <rdfs:domain rdf:resource="FEED-ON::ConsequenceExpected"/>
  <rdfs:range rdf:resource="FEED-ON::Feedback"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Configurar propriedades inversas ajuda o pipeline a rastrear o caminho de volta (do ticket no Jira até o feedback original).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="http://dev.nemo.inf.ufes.br/seon/indicates">
  <rdfs:domain rdf:resource="FEED-ON::Feedback"/>
