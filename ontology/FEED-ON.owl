  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 7a0efd9f-2f66-4bef-bf19-410ae477889a__job13__row895</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Very very disappointed! was so excited to finally have Netflix but Amazon prime is better to use in the end. there is a glitch somewhere in their system and they can't fix it. i can't watch anything "over 19+" and despite contacting them about 7/8times they just didn't care and didn't help at all!! i contacted my phone supplier and many others to try to fix it but nothing worked. hugely disappointed in Netflix!!</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

