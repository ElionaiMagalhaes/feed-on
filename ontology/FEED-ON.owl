  <seon:aimsToEvolve rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Pay"/>
  <seon:jiraKey rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PENDING</seon:jiraKey>
</owl:NamedIndividual>

