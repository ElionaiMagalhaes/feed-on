  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Account"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_8fda3e3c_539c_45cb_9730_1bbb8458eb27__job13__row855"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_8fda3e3c_539c_45cb_9730_1bbb8458eb27__job13__row855"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_8fda3e3c_539c_45cb_9730_1bbb8458eb27__job13__row855"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 8fda3e3c-539c-45cb-9730-1bbb8458eb27__job13__row855</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I have a Netflix account where we're supposed to be able to watch Netflix on FOUR devices at a time. However, my sister is in Hospice, so I take my streaming stick so we can watch a show, and if any of my kids are trying to watch Netflix on even ONE device, we can't watch on the streaming stick! Netflix has gotten SO cheap and paranoid that for their expensive account, you can watch ONE SHOW AT MOST! Shame on your greed Netflix!!! And your false advertising!!!</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

