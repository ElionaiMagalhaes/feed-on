<owl:NamedIndividual rdf:about="FEED-ON:Feedback_9836646c_1d51_455d_a4f3_26eb10f39eff__job13__row62">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Household"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_9836646c_1d51_455d_a4f3_26eb10f39eff__job13__row62"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_9836646c_1d51_455d_a4f3_26eb10f39eff__job13__row62"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_9836646c_1d51_455d_a4f3_26eb10f39eff__job13__row62"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 9836646c-1d51-455d-a4f3-26eb10f39eff__job13__row62</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">》DON'T WAIST YOUR TIME《 I'm really frustrated with Netflix's recent changes. I've been a loyal customer since launch, and sharing with family used to be a big part of the experience. Now, their new rules are making it tough – they want everyone in a household to have their own account. Feels like they're abandoning their sharing roots. Im seriously considering on canceling and finding a new streaming service to use. Wish I could rate lower.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

