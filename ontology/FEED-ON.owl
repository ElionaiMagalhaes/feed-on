  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_88153621_21d7_4e88_9a36_09d9d7988312__job13__row350"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_88153621_21d7_4e88_9a36_09d9d7988312__job13__row350"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 88153621-21d7-4e88-9a36-09d9d7988312__job13__row350</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Netflix is hands down my go-to for movie nights! The variety is incredible — from the latest blockbusters to the most unique, offbeat documentaries, there’s always something for every mood. The interface is smooth and easy to navigate, and the recommendations are surprisingly spot-on. While it may be a bit on the pricier side, the quality and endless entertainment make it absolutely worth it. Perfect for solo binges or weekend marathons — Netflix never disappoints! 🎬🍿</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

