    <owl:ObjectProperty rdf:about="http://dev.nemo.inf.ufes.br/seon/FEED-ON.owl#aimsToEvolve">
        <rdfs:domain rdf:resource="http://dev.nemo.inf.ufes.br/seon/FEED-ON.owl#ConsequenceExpected"/>
        <rdfs:range rdf:resource="http://dev.nemo.inf.ufes.br/seon/FEED-ON.owl#Target"/>
        <rdfs:comment>It defines which software component the developer should open to perform the correction or improvement.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://dev.nemo.inf.ufes.br/seon/FEED-ON.owl#derivedFrom -->

