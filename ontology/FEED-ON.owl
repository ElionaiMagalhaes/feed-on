  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_87ebc528_4688_46b2_9b28_b29a2c11d0b1__job13__row365"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 87ebc528-4688-46b2-9b28-b29a2c11d0b1__job13__row365</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">edit: way to go not having to political pressure. I guess I'll keep it. 1 star to 4. ------------ Won't let me log into the TV in the bedroom at my parents' house because it's not part of my household. I am afraid to add this TV to my household since it's not part of it. No option for "Im traveling". funny how I used it last night without problem. I am now having to watch TV as I go to sleep on the app on my phone. I guess I'll cancel netflix, and Ill watch a different service from now on.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

