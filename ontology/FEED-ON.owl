<owl:NamedIndividual rdf:about="FEED-ON:Feedback_aecf0b4b_950d_4940_8540_51f7e873818a__job13__row452">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_Suggestion"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Subscription"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Improvement_aecf0b4b_950d_4940_8540_51f7e873818a__job13__row452"/>
