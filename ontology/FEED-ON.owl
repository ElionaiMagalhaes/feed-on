  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Pay"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_bac077db_00b7_4f17_a525_b6fd209db465__job13__row442"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_bac077db_00b7_4f17_a525_b6fd209db465__job13__row442"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_bac077db_00b7_4f17_a525_b6fd209db465__job13__row442"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback bac077db-00b7-4f17-a525-b6fd209db465__job13__row442</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Very disappointing billing experience with Netflix. My mandate was successfully debited, yet the app kept showing “payment not updated” and blocked access to content. I was forced to pay multiple times just to continue watching. This resulted in duplicate charges, and while one refund was processed, another payment is still not refunded. For a global platform of this scale, such payment synchronization issues with UPI AutoPay are unacceptable. Customers should not have to chase refunds.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="http://dev.nemo.inf.ufes.br/seon/Correction_bac077db_00b7_4f17_a525_b6fd209db465__job13__row442">
