<owl:NamedIndividual rdf:about="FEED-ON:Feedback_a84a28d4_6b1d_43ca_9f04_5fa6bc310411__job13__row712">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_a84a28d4_6b1d_43ca_9f04_5fa6bc310411__job13__row712"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_a84a28d4_6b1d_43ca_9f04_5fa6bc310411__job13__row712"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_a84a28d4_6b1d_43ca_9f04_5fa6bc310411__job13__row712"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback a84a28d4-6b1d-43ca-9f04-5fa6bc310411__job13__row712</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">I am extremely disappointed with this app. I like comedy. How is drama funny? One joke or funny situation in a whole movie down not mean it is a comedy. There are some idiots that are failing miserably when labelling these moves, where can I apply for that job. I too can lie on my resume and call a drama a horror movie. I grew up on Skid row and saw real tragedies. I watch movies to make me smile and laugh not to remind me of the tragedies around me. I see why people go POSTAL. NETFLIX SUCKS!</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

