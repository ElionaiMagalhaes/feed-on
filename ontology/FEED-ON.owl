<owl:NamedIndividual rdf:about="FEED-ON:Feedback_968cf9d4_8c3b_4958_9b51_0ad03c5548d9__job13__row587">
  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Requirement_Household"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_968cf9d4_8c3b_4958_9b51_0ad03c5548d9__job13__row587"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_968cf9d4_8c3b_4958_9b51_0ad03c5548d9__job13__row587"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_968cf9d4_8c3b_4958_9b51_0ad03c5548d9__job13__row587"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback 968cf9d4-8c3b-4958-9b51-0ad03c5548d9__job13__row587</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The new one household police is so annoying and tracks where you go and what Internet you connect to is far from private. Trying to travel and sign in every time via email to watch anything gets so frustrating. I hope they lose business because of this! I for sure won't be using Netflix ever again.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

