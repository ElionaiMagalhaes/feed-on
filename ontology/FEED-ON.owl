  <rdf:type rdf:resource="FEED-ON::Feedback"/>
  <seon:hasIntention rdf:resource="http://dev.nemo.inf.ufes.br/seon/Intention_BugReport"/>
  <seon:refersTo rdf:resource="http://dev.nemo.inf.ufes.br/seon/Feature_General"/>
  <seon:indicates rdf:resource="http://dev.nemo.inf.ufes.br/seon/Correction_d9a2d291_09ff_497b_ae80_26edb7c077aa__job13__row149"/>
  <seon:isElicitedThrough rdf:resource="http://dev.nemo.inf.ufes.br/seon/ExplicitFeedbackElicitation"/>
  <seon:isProvidedBy rdf:resource="FEED-ON:ExternalAgent_d9a2d291_09ff_497b_ae80_26edb7c077aa__job13__row149"/>
  <seon:hasSentiment rdf:resource="http://dev.nemo.inf.ufes.br/seon/Sentiment_d9a2d291_09ff_497b_ae80_26edb7c077aa__job13__row149"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feedback d9a2d291-09ff-497b-ae80-26edb7c077aa__job13__row149</rdfs:label>
  <seon:commentText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">So I was watching a movie, that was being taken off Netflix, and 10 mins past midnight it stopped playing. You could at least let people finish watching a movie if it's being watched before taking it off. This is really annoying. maybe take movies off at one a m instead of midnight.So people have a chance to finish watching. otherwise I love netflix. Ive been a customer since the company started.</seon:commentText>
  <seon:isProcessed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</seon:isProcessed>
</owl:NamedIndividual>

